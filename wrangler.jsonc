{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "party-audience",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "party-audience",
      "database_id": "b2cf6e3e-d7b7-48b3-a3b3-86bf81d82131",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_ROOMS", "class_name": "SessionRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }
  ]
  // Vars/segredos por ambiente (dev: .dev.vars; produção: wrangler secret put):
  //   TV_SOURCE              — fonte da TV 24h (docs/tv-partner-contract.md)
  //   CLOUDFLARE_ACCOUNT_ID  — conta Cloudflare (docs/media-gateway.md)
  //   REALTIMEKIT_APP_ID     — app RealtimeKit dentro da conta
  //   CLOUDFLARE_API_TOKEN   — token com permissão Realtime
  //   RTK_PRESET_*           — sobrescritas opcionais dos presets
}
